# Accepted Admissions — environment variable template
# Copy to .env (or configure secrets in your host) and fill in real values.
# Do not commit real credentials, personal emails, Clerk user IDs, or live URLs.

# ---------------------------------------------------------------------------
# Core runtime
# ---------------------------------------------------------------------------

# Postgres connection string used by the API and Drizzle migrations.
DATABASE_URL=

# Node environment: development | production | test
NODE_ENV=

# HTTP listen port for local Vite / preview servers (optional; defaults exist).
PORT=

# Optional Vite base path when the app is served under a subpath.
BASE_PATH=

# API / browser origin used for absolute redirects and OAuth return URLs.
APP_ORIGIN=

# Public site origin used for canonical URLs, Open Graph tags, sitemap, and robots.
# Production default in the frontend build is https://www.acceptedadmissions.org
PUBLIC_SITE_ORIGIN=

# Optional log level for the API (default: info).
LOG_LEVEL=

# Session signing secret for calendar OAuth state and related signed cookies.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Clerk authentication
# ---------------------------------------------------------------------------

# Clerk secret key for the API (server-side).
CLERK_SECRET_KEY=

# Clerk publishable key for the API.
CLERK_PUBLISHABLE_KEY=

# Vite publishable key for the browser app.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional Clerk Frontend API proxy path/URL for the browser (if used).
VITE_CLERK_PROXY_URL=

# ---------------------------------------------------------------------------
# Role allowlists (comma-separated)
# Administrator and viewer remain environment-only.
# Tutor/student People provisioning writes Production Clerk users + DB grants;
# these ACCEPTED_STUDENT/TUTOR_* lists are optional legacy overrides only.
# Prefer Clerk user IDs. Email lists are verified-primary-email fallbacks only.
# Never commit real IDs or personal emails into git.
# ---------------------------------------------------------------------------

ACCEPTED_ADMIN_CLERK_USER_IDS=
ACCEPTED_SAT_TUTOR_CLERK_USER_IDS=
ACCEPTED_ENGLISH_TUTOR_CLERK_USER_IDS=
ACCEPTED_TUTOR_CLERK_USER_IDS=
ACCEPTED_STUDENT_CLERK_USER_IDS=
ACCEPTED_VIEWER_CLERK_USER_IDS=

ACCEPTED_ADMIN_EMAILS=
ACCEPTED_SAT_TUTOR_EMAILS=
ACCEPTED_ENGLISH_TUTOR_EMAILS=
ACCEPTED_TUTOR_EMAILS=
ACCEPTED_STUDENT_EMAILS=
ACCEPTED_VIEWER_EMAILS=

# ---------------------------------------------------------------------------
# Stripe (Accepted Admissions platform account — official Node SDK)
# ---------------------------------------------------------------------------

# Secret API key for the Accepted Admissions Stripe account (server-side only).
# Do not hard-code price IDs; catalog prices are stored on sat_products after creation.
STRIPE_SECRET_KEY=

# Webhook signing secret for verifying Stripe events.
STRIPE_WEBHOOK_SECRET=

# Set to 1 only in disposable test environments to enable Stripe regression cases.
# Does not switch a live Stripe connection into test mode by itself.
STRIPE_TEST_MODE=

# ---------------------------------------------------------------------------
# Google Calendar (tutor availability / booking)
# ---------------------------------------------------------------------------

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# HTTPS OAuth callback URL registered with Google for this environment.
# Production must be exactly: https://app.acceptedadmissions.org/api/calendar/oauth/callback
# That same URI must be allowlisted on the Google Cloud OAuth client.
# If unset, production falls back to ${APP_ORIGIN}/api/calendar/oauth/callback (HTTPS required).
GOOGLE_CALENDAR_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Question generation (quiz workspace)
# ---------------------------------------------------------------------------

# Server-side OpenAI key for "Generate questions" on an open quiz.
# Without this key the API returns 503 and the UI shows a blocked state.
# Template drafts are a separate experimental path and are not a model provider.
OPENAI_API_KEY=

# Optional model override. Default: gpt-4o-mini
OPENAI_QUESTION_MODEL=

# ---------------------------------------------------------------------------
# Host-provided / optional
# ---------------------------------------------------------------------------

# Present on Replit previews; used only as a non-production origin fallback.
REPLIT_DEV_DOMAIN=
REPL_ID=
