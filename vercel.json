{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/accepted-admissions run build",
  "outputDirectory": "artifacts/accepted-admissions/dist/public",
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path(login|sign-in|portal|tutor|admin|t-g|sso-callback)",
      "has": [
        {
          "type": "host",
          "value": "www.acceptedadmissions.org"
        }
      ],
      "destination": "https://app.acceptedadmissions.org/:path",
      "permanent": false
    },
    {
      "source": "/:path(login|sign-in|portal|tutor|admin|t-g|sso-callback)/:rest*",
      "has": [
        {
          "type": "host",
          "value": "www.acceptedadmissions.org"
        }
      ],
      "destination": "https://app.acceptedadmissions.org/:path/:rest*",
      "permanent": false
    },
    {
      "source": "/:path(login|sign-in|portal|tutor|admin|t-g|sso-callback)",
      "has": [
        {
          "type": "host",
          "value": "acceptedadmissions.org"
        }
      ],
      "destination": "https://app.acceptedadmissions.org/:path",
      "permanent": false
    },
    {
      "source": "/:path(login|sign-in|portal|tutor|admin|t-g|sso-callback)/:rest*",
      "has": [
        {
          "type": "host",
          "value": "acceptedadmissions.org"
        }
      ],
      "destination": "https://app.acceptedadmissions.org/:path/:rest*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://accepted-admissions-platform-production.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
