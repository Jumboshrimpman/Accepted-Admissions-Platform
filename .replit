modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "build-without-preview-settings"

[[workflows.workflow]]
name = "build-without-preview-settings"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run check:build-without-preview-settings"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

# Role allowlists and OAuth callbacks must be supplied via Secrets / environment
# variables (see .env.example and docs/accepted-admissions-provisioning.md).
# Do not commit Clerk user IDs, personal emails, or environment-specific URLs here.
[userenv]

[userenv.shared]
